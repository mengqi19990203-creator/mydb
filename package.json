{
  "name": "mydb",
  "private": true,
  "version": "0.9.0",
  "description": "A lightweight, cross-platform database client",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit && npm run check:rust",
    "check:rust": "[ -f \"$HOME/.cargo/env\" ] && . \"$HOME/.cargo/env\"; cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "[ -f \"$HOME/.cargo/env\" ] && . \"$HOME/.cargo/env\"; tauri",
    "tauri:dev": "npm run tauri -- dev",
    "tauri:build": "npm run tauri -- build"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror": "^6.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
